    m_HorizontalOverflow: 1
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "PLAY IN FULLSCREEN\n\nLIGHT ATTACKS KEYS:\nUSE KEYBOARD NUMBERS\n\n1 -
    Fireball\n2 - Waterball\n3 - Eletricballl\n4- Blackholeball\n\nHEAVY ATTACKS
    KEYS:\n5 - Firelaser\n6 - Waterlaser\n7 - Eletriclaser\n8 - Blackholelaser\n\nAoE
    SPELLS\nH - Heal\nJ  - Buff\nK - Critrical\n\nRight Mouse: Light Attack \nLeft
    Mouse: Heavy Attack\n\nKEY \"Shift\" - Sprint\nKEY \"C\" Switch Camera\nKEY \"F\"
    - LOCKON DUMMY\n\nfor more read the\ninstructions PDF"
